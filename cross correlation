clc;
clear;
close all;

data=readtable();
x=data.ecg;
y=data.ppg
fs=---

% Cross-correlation
[r,lags]=xcorr(x,y);
% Find maximum correlation
[mx,i]=max(r)
% Calculate delay
delay=lags(i)/Fs

% Display output
fprintf('Maximum Correlation = %.2f\n', mx);
fprintf('Delay = %.3f seconds\n', delay);

% Plot
subplot(3,1,1);
plot(x);
title('ECG Signal');
grid on;

subplot(3,1,2);
plot(y);
title('PPG Signal');
grid on;

subplot(3,1,3);
plot(lags/Fs, r);
title('Cross-Correlation');
xlabel('Lag (seconds)');
ylabel('Correlation');
grid on;


