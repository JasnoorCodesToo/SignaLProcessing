   y6(i)=x(N-i+1):
end

clc; clear; close all;

fm = 5;
t = 0:0.001:1;
x = sin(2*pi*fm*t);
 %sampling 
fs = 20;
[ts, xs] = sample(fm, fs);

plot(t,x);
hold on;
stem(ts,xs);
legend('Original Signal','Sampled Signal');
title('Sampling Theorem Verification');

function [t,x] = sample(fm,fs)
    t = 0:1/fs:1;
    x = sin(2*pi*fm*t);
end


