clc;
clear;
close all;

%load data set
data = readmatrix('data.csv');
x = data(:,1)
x=x(~isnan(x));
N = length(x);
n=0:N-1;

%DFT
X=zeros(N,1);
for k = 0:N-1;
  for n1= 0:N-1
     X(k+1)=X(k+1)+x(n1+1)*exp(2*pi*k*-1i*k*n1/N);
  end
end

%magnitude and phase
phase=angle(X)
mag=abs(X)

%IDFT
xr=zeros(N,1);

for n1=0:N-1
   for k=0:N-1
     xr(n1+1)=xr(n1+1)+X(k+1)*exp(1i*2*pi*k*n1/N);
  end
 xr(n1+1)= xr(n1+1)/N;
end

figure;
plot(x);
title(orgsignal);
figure;
stem(mag);
title('Magnitude Spectrum');

figure;
stem(phase);
title('Phase Spectrum');
figure;
plot(x,'b');
hold on;
plot(real(xr),'r--');
title('Original vs Reconstructed Signal');
legend('Original','Reconstructed');


