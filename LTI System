clc;
clear ;
close all;

%load data
filename=input(csv,s);
data=readtable(filename);

%choose ip n op
ipsig=data.t1
opsig=data.appliances

%take first 100 
N=100
if height(data)<N
    N=height(data);
end
ipsig=ipsig(1:N)
opsig=opsig(1:N)

%maximum lena hai for k
maxip=ipsig(1)
maxop=opsig(1)

for i=2:N
   if ipsig(i)>maxip
      maxip=ipsig(i);
   end
  if opsig(i)>maxop
      maxop=opsig(i);
   end
end

%system parameters
k=maxop/maxip;
tau=5;

%define time
dt=0.05
t=0:dt:30
M=length(t)

%initialise kro PEHLE INP KA FER OP KA
u1=ones(1,M);
u2=2*ones(1,M);
Udelayed=zeroes(1,M);

y1=zeroes(1,M);
y2=2*zeroes(1,M);
ydelayed=zeroes(1,M);

%create delayed step ip
for i=1:M
   if t(i)>=5
      Udelayed(i)=1;
   end
end

%sys op calculate

for i=2:M
   y1(i)=y1(i-1)+dt/tau*(k*u1(i-1)-y1(i-1));
   y2(i)=y2(i-1)+dt/tau*(k*u2(i-1)-y2(i-1));
  ydelayed(i)=ydelayed(i-1)+dt/tau*(k*Udelayed(i-1)-ydelayed(i-1));
end

%ploting ip n op
figure;

subplot(2,1,1);
plot(ipsig);
title('input signal');

subplot(2,1,2);
plot(opsig);
title('output signal');

figure;
plot(t,y1);
title('Step Response');
xlabel('Time');
ylabel('Output');
grid on;

%linearity test
 figure:
plot(t,y1,'b',t,y2,'r');
title('Linearity Test');
legend('Input 1','Input 2');
grid on;

%linearity error
E=0;

for i=1:M
    e=abs(y2(i)-2*y1(i));
    if e>E
       E=e;
    end
end


% time invariance test
figure;
plot(t,y1,'b',t,yDelayed,'r');
title('Time Invariance Test');
legend('Normal Response','Delayed Response');
grid on;

% display results
disp(['Gain = ',num2str(k)]);
disp(['Time Constant = ',num2str(tau)]);
disp(['Linearity Error = ',num2str(E)]);

disp('Experiment completed');





