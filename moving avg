clc;
clear;
close all;

%load dataset
filename=input('csv','s')
data=readmatrix(filename);

%select signal
x=data(1,1:end-1)
N=length(x);

%moving avg filter
M=5
h=ones(1,M)/M;

%LINEAR CONV
L=N+M-1;
y=zeros(1,L);

for n = 1:L
   for k=1:N
 j = n-k+1;
        if j >= 1 && j <= M
            y(n) = y(n) + x(k)*h(j);
        end
    end
end

% Plot
figure;
subplot(2,1,1);
plot(x);
title('Original ECG Signal');

subplot(2,1,2);
plot(y);
title('Filtered ECG Signal');

disp('Filtered signal:');
disp(y);


